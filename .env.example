# router-ssh-mcp 环境变量示例
# 用法（Linux/macOS）：cp .env.example .env && set -a && . ./.env && set +a
# 用法（Windows PowerShell）：复制为 .env.ps1 后逐行 $env:ROUTER_MCP_HOST="192.168.1.1"

# ---- 连接 ----
ROUTER_MCP_HOST=192.168.1.1
ROUTER_MCP_PORT=22
ROUTER_MCP_USER=root

# 认证二选一（同时提供时优先密钥）
ROUTER_MCP_PASSWORD=
ROUTER_MCP_KEY_PATH=
ROUTER_MCP_KEY_PASSPHRASE=

# ---- 行为 ----
# auto | procd | systemd | sysvinit
ROUTER_MCP_INIT_SYSTEM=auto
ROUTER_MCP_CONNECT_TIMEOUT=8
ROUTER_MCP_COMMAND_TIMEOUT=12
ROUTER_MCP_KEEPALIVE_INTERVAL=15
ROUTER_MCP_KEEPALIVE_COUNT=3
ROUTER_MCP_MAX_RECONNECT_ATTEMPTS=2
ROUTER_MCP_MAX_LOG_LINES=500

# ---- 安全 ----
ROUTER_MCP_REQUIRE_CONFIRM=true
ROUTER_MCP_ALLOWED_SERVICES=
ROUTER_MCP_DENIED_SERVICES=network,firewall,system,boot,done
ROUTER_MCP_STRICT_HOST_KEY=false
ROUTER_MCP_KNOWN_HOSTS=

# ---- 高危 shell 能力（默认全部关闭）----
# 置为 true 才会启用 run_shell 工具；启用后需把 confirm 设为命令本身进行二次确认
ROUTER_MCP_ALLOW_SHELL=false
# shell 命令是否需要二次确认（默认 true）
ROUTER_MCP_SHELL_REQUIRE_CONFIRM=true
# 是否拦截高危命令（rm -rf / mkfs / dd / 写入 /dev/* / fork 炸弹 / 管道进 shell 等，默认 true）
ROUTER_MCP_SHELL_DENY_UNSAFE=true

# ---- 其他 ----
ROUTER_MCP_CONFIG=
ROUTER_MCP_LOG_LEVEL=WARNING
